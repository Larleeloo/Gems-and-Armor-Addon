{
  "format_version": "1.20.50",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:player",
      "is_spawnable": false,
      "is_summonable": false,
      "is_experimental": false
    },
    "component_groups": {
      "gaa:shrunk_group": {
        "minecraft:scale": { "value": 0.111 },
        "minecraft:movement": { "value": 0.04 }
      }
    },
    "events": {
      "gaa:shrink": {
        "add": { "component_groups": [ "gaa:shrunk_group" ] }
      },
      "gaa:unshrink": {
        "remove": { "component_groups": [ "gaa:shrunk_group" ] }
      }
    }
  }
}
